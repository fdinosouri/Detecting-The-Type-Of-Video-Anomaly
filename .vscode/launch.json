{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "1) Make annotations",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/annotations/make_annotations.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "--root", "D:/datasets/UCF_Crime",
                "--test-split", "D:/datasets/UCF_Crime/Anomaly_Detection_splits/Anomaly_Test.txt"
            ]
        },
        {
            "name": "2) Train",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/train.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "--config", "configs/videomae_ucf_crime.yaml"
            ],
            "justMyCode": false
        },
        {
            "name": "2b) Resume training",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/train.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "--config", "configs/videomae_ucf_crime.yaml",
                "--resume", "checkpoints/last.pth"
            ],
            "justMyCode": false
        },
        {
            "name": "3) Evaluate",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/evaluate_multiclass.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "--config", "configs/videomae_ucf_crime.yaml",
                "--checkpoint", "checkpoints/best.pth"
            ],
            "justMyCode": false
        },
        {
            "name": "4) Extract features (optional)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/extract_features.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "--config", "configs/videomae_ucf_crime.yaml",
                "--list", "annotations/train.txt",
                "--out", "features/train",
                "--checkpoint", "checkpoints/best.pth"
            ],
            "justMyCode": false
        }
    ]
}
