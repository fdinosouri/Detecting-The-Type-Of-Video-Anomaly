# Datasets and anything derived from them. These are gigabytes and GitHub
# rejects any single file over 100 MB, so a plain `git add .` in a working
# directory that holds them will fail the push.
dataset/
frames/
videos/
UCF/
TAD/
features/
*.npy
*.mp4
*.avi

