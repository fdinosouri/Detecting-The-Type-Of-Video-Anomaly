exp/
exp_*/
output/
runs/
*.pth
*.pt
*.ckpt
*.pkl
*.log

# Split files are regenerated by make_standard_split.py from the dataset,
# and the large ones are noise in a diff. Keep labels/*.csv, which is
# small and part of the method.
labels/*.txt

